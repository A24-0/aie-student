# Скопируйте в project/.env и при необходимости измените.
# Настоящий .env в git не попадает (см. корневой .gitignore).

# Общие настройки
AIE_LOG_LEVEL=INFO
AIE_SERVICE_HOST=0.0.0.0
AIE_SERVICE_PORT=8000

# Режим генерации ответа: extractive (по умолчанию, без сети) или llm
AIE_GENERATION_MODE=extractive

# Нужно только для режима llm. Ключ НИКОГДА не коммитим.
# AIE_LLM_API_KEY=sk-...
# AIE_LLM_MODEL=openai/gpt-4o-mini
# AIE_LLM_BASE_URL=https://openrouter.ai/api/v1

# Тише логи Hugging Face при сборке индекса
HF_HUB_DISABLE_PROGRESS_BARS=1
